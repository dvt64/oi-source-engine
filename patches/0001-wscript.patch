diff --git a/wscript b/wscript
index 16f2263..a6c57d6 100644
--- a/wscript
+++ b/wscript
@@ -266,6 +266,17 @@ def define_platform(conf):
 			'_DLL_EXT=.so'
 		])
 
+	elif conf.env.DEST_OS == 'sunos':
+		conf.define('_GLIBCXX_USE_CXX11_ABI',0)
+		conf.env.append_unique('DEFINES', [
+			'LINUX=1', '_LINUX=1',
+			'POSIX=1', '_POSIX=1', 'PLATFORM_POSIX=1',
+			'GNUC',
+			'NO_HOOK_MALLOC',
+			'SUNOS=1', '_SUNOS=1',
+			'_DLL_EXT=.so'
+		])
+
 	if conf.env.DEST_OS != 'win32':
 		conf.define('NO_MEMOVERRIDE_NEW_DELETE', 1)
 #		conf.define('NO_MALLOC_OVERRIDE', 1)
@@ -322,6 +333,9 @@ def options(opt):
 	grp.add_option('--sanitize', action = 'store', dest = 'SANITIZE', default = '',
 		help = 'build with sanitizers [default: %default]')
 
+	grp.add_option('--disable-mimalloc', action = 'store_true', dest = 'DISABLE_MIMALLOC', default = False,
+		help = 'do not link libmimalloc (on sunos mimalloc is enabled by default) [default: %default]')
+
 	opt.load('compiler_optimizations subproject')
 
 	opt.load('xcompile compiler_cxx compiler_c sdl2 clang_compilation_database strip_on_install_v2 waf_unit_test subproject')
@@ -532,6 +546,18 @@ def configure(conf):
 	if conf.env.DEST_OS == 'freebsd':
 		linkflags += ['-lexecinfo']
 
+	if conf.env.DEST_OS == 'sunos':
+		conf.check_cc(lib='socket', mandatory=True)
+		conf.check_cc(lib='nsl', mandatory=True)
+		linkflags += ['-lsocket', '-lnsl']
+
+		if not conf.options.DISABLE_MIMALLOC:
+			conf.check_cc(lib='mimalloc', linkflags=['-L/usr/lib'], mandatory=True)
+			conf.define('USE_MIMALLOC', 1)
+			conf.env.USE_MIMALLOC = True
+			linkflags += ['-L/usr/lib', '-Wl,-R/usr/lib', '-lmimalloc', '-lpthread']
+			conf.msg('mimalloc', 'enabled (linked into all targets)')
+
 	if conf.env.DEST_OS != 'win32':
 		cflags += flags
 		linkflags += flags
